########################
# TELEGRAM
########################
TG_BOT_KEY=XXXXXXXXXX:XXXxxxXXXxxxxXXXxxx
# can talk privately to anyone
TG_PUBLIC=true
TG_MASTER_ID=XXXXXXXXX
TG_MASTER_IDS=[XXXXXXXXX, XXXXXXXXX]
# can talk in these groups only
TG_FRIEND_GROUP_IDS=[-XXXXXXXXX, -XXXXXXXXX]
# reacts to this messages in group
TG_REACTION_CALLS=["hello","hi"]
# sometimes sends random sticker from this list
TG_STICKER_LIST=["CAACAgIAAxkBAAELx29l_2OsQzpRWhmXTIMBM4yekypTOwACdgkAAgi3GQI1Wnpqru6xgTQE"]
# if to send starting message to master
TG_SAY_HI=true
# split big answers into several messages
TG_CHUNK_SENTENCES=13


########################
# STORAGE — history, chat_data, media backends
########################
# File storage root (used by all backends for tmp, media when MEDIA_BACKEND=file)
APP_FILESTORE_LOCATION=~/.kibernikto
# imgbb TTL in seconds (0 = no expiration); URLs in history must stay alive
IMAGE_STORAGE_EXPIRATION=0
# Backend selection: "file" (default), "pg" (PostgreSQL), "sqlite"
# APP_STORAGE_DATA_BACKEND=file
# Backend selection: "file" (default), "s3" (S3-compatible object storage)
# APP_STORAGE_MEDIA_BACKEND=file
# PostgreSQL DSN (required when DATA_BACKEND=pg)
# APP_STORAGE_PG_DSN=postgresql+asyncpg://user:pass@host:5432/kibernikto
# SQLite path (used when DATA_BACKEND=sqlite, default :memory:)
# APP_STORAGE_SQLITE_PATH=~/.kibernikto/kibernikto.db
# S3-compatible storage (required when MEDIA_BACKEND=s3)
# APP_STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# APP_STORAGE_S3_BUCKET=kibernikto-media
# APP_STORAGE_S3_REGION=us-east-1
# APP_STORAGE_S3_ACCESS_KEY=AKIA...
# APP_STORAGE_S3_SECRET_KEY=...

########################
# OPENAI CLIENT
########################
OPENAI_INSTANCE_ID=kibernikto
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# https://api.vsegpt.ru:6070/v1 for vsegpt
# https://openrouter.ai/api/v1 for openrouter
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=550
OPENAI_TEMPERATURE=0.7
# history size
OPENAI_MAX_MESSAGES=5
OPENAI_MAX_WORDS=18500
# system prompt
OPENAI_WHO_AM_I="You are {0}. Respond in the style of Alexander Sergeyevich Pushkin, but with a verse probability of no more than 30 percent."
# if u have tools
OPENAI_TOOLS_ENABLED=true

########################
# AGENTS https://ai.pydantic.dev/models/overview/
########################
AGENT_KIBERNIKTO_NAME=kibernikto
AGENT_KIBERNIKTO_PROVIDER_TYPE=openai
AGENT_KIBERNIKTO_PROVIDER_KEY=
AGENT_KIBERNIKTO_PROVIDER_CUSTOM_URL=
AGENT_KIBERNIKTO_MODEL_NAME=openrouter:anthropic/claude-sonnet-4-5
AGENT_KIBERNIKTO_IMAGE_MODEL_NAME=openrouter:google/gemini-2.5-flash-image-preview

AGENT_KIBERNIKTO_MODEL_MAX_TOKENS=760
AGENT_KIBERNIKTO_MODEL_TEMPERATURE=0.7
# keep model reasoning in history? false = drop (saves tokens); true = keep text, strip signature
AGENT_KIBERNIKTO_KEEP_THINKING_IN_HISTORY=false
AGENT_KIBERNIKTO_MODEL_PARALLEL_TOOL_CALLS=true
AGENT_KIBERNIKTO_WHO_AM_I=kibernikto
VOICE_OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VOICE_PROCESSOR=openai
# stt-openai/whisper-1 for vsegpt
VOICE_OPENAI_API_MODEL=whisper-1
VOICE_OPENAI_API_BASE_URL=https://api.openai.com/v1

# Credits & model balancing for KiberniktoExtended
AGENT_KIBERNIKTO_TRIAL_CREDITS=260
AGENT_KIBERNIKTO_POOR_CREDITS=30
AGENT_KIBERNIKTO_RICH_CREDITS=500
AGENT_KIBERNIKTO_POOR_MODEL=openrouter:google/gemini-2.5-flash
AGENT_KIBERNIKTO_MEDIUM_MODEL=openrouter:anthropic/claude-sonnet-5
AGENT_KIBERNIKTO_RICH_MODEL=openrouter:anthropic/claude-sonnet-5

########################
# JINA AI — web expert (reader, search, deepsearch)
########################
JINA_AI_API_KEY=
