########################
# TELEGRAM
########################
TG_BOT_KEY=XXXXXXXXXX:XXXxxxXXXxxxxXXXxxx
# can talk privately to anyone
TG_PUBLIC=true
# your Telegram user id (admin); lists are JSON
TG_MASTER_ID=111111111
TG_MASTER_IDS=[111111111, 222222222]
# can talk in these groups only (omit to allow any group)
TG_FRIEND_GROUP_IDS=[-1001111111111]
# reacts to these substrings in groups (plus the bot's own name)
TG_REACTION_CALLS=["hello","hi"]
# startup greeting sticker sent to TG_MASTER_ID when TG_SAY_HI=true
TG_STICKER_IDS=["CAACAgIAAxkBAAELx29l_2OsQzpRWhmXTIMBM4yekypTOwACdgkAAgi3GQI1Wnpqru6xgTQE"]
TG_SAY_HI=true
# optional: forward user messages and error reports to this group
# TG_SERVICE_GROUP_ID=-1002222222222


########################
# STORAGE — history, chat_data, media backends
########################
# File storage root: the Dockerfile pins it to the /data volume; --env-file would override, keep unset
# APP_STORAGE_FILESTORE_LOCATION=/data
# Backend selection: "file" (default), "pg" (PostgreSQL), "sqlite"
# APP_STORAGE_DATA_BACKEND=file
# Backend selection: "file" (default), "s3" (S3-compatible object storage)
# APP_STORAGE_MEDIA_BACKEND=file
# PostgreSQL DSN (required when DATA_BACKEND=pg)
# APP_STORAGE_PG_DSN=postgresql+asyncpg://user:pass@host:5432/kibernikto
# SQLite file (DATA_BACKEND=sqlite); the Dockerfile pins it to /data/kibernikto.db
# APP_STORAGE_SQLITE_PATH=/data/kibernikto.db
# S3-compatible storage (required when MEDIA_BACKEND=s3 or IMAGE_HOSTING_PROVIDER=s3)
# APP_STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# APP_STORAGE_S3_BUCKET=kibernikto-media
# APP_STORAGE_S3_REGION=us-east-1
# APP_STORAGE_S3_ACCESS_KEY=AKIA...
# APP_STORAGE_S3_SECRET_KEY=...


########################
# PUBLIC IMAGE HOSTING — URLs the model fetches for photos and generated images
########################
# "imgbb" (default) or "s3"
IMAGE_HOSTING_PROVIDER=imgbb
# imgbb: API key and TTL in seconds (0 = no expiration; history links must stay alive)
IMAGE_STORAGE_API_KEY=
IMAGE_STORAGE_EXPIRATION=0
# s3: reuses APP_STORAGE_S3_* credentials. Anonymous read must be granted on IMAGE_S3_PREFIX
# (bucket policy or CDN); keys are random UUIDs and never overwritten.
# IMAGE_S3_PUBLIC_BASE_URL=https://cdn.example.com
# public bucket; defaults to APP_STORAGE_S3_BUCKET
# IMAGE_S3_BUCKET=kibernikto-public
# IMAGE_S3_PREFIX=public
# canned ACL, only for providers that support it
# IMAGE_S3_ACL=public-read


########################
# MODELS https://ai.pydantic.dev/models/overview/
########################
# Provider keys for the prefixes used below (openrouter:, vsegpt:, routerai:, beget:, openai:, ...)
# New OpenAI-compatible gateways: OPENAI_COMPATIBLE_PROVIDERS in kibernikto/ai/agent/utils.py
OPENROUTER_API_KEY=
# VSEGPT_API_KEY=
# ROUTERAI_API_KEY=
# BEGET_AI_API_KEY=

AGENT_KIBERNIKTO_NAME=kibernikto
# parent's reaction on the user's message when it calls its own tools (delegates show theirs); empty = none
AGENT_KIBERNIKTO_REACTION=👀
AGENT_KIBERNIKTO_MODEL_NAME=openrouter:anthropic/claude-sonnet-5
AGENT_KIBERNIKTO_IMAGE_MODEL_NAME=openrouter:google/gemini-2.5-flash-image-preview
AGENT_KIBERNIKTO_MODEL_MAX_TOKENS=1300
AGENT_KIBERNIKTO_MODEL_TEMPERATURE=0.7
AGENT_KIBERNIKTO_HISTORY_SIZE=20
# keep model reasoning in history? false = drop (saves tokens); true = keep text, strip signature
AGENT_KIBERNIKTO_KEEP_THINKING_IN_HISTORY=false
AGENT_KIBERNIKTO_MODEL_PARALLEL_TOOL_CALLS=true
# persona (Handlebars: {{name}}, {{traits.x}}); overridden by {APP_STORAGE_FILESTORE_LOCATION}/{AGENT_KIBERNIKTO_NAME}-instructions.txt
# no quotes: docker --env-file keeps them literally
AGENT_KIBERNIKTO_WHO_AM_I=You are {{name}}, a witty and precise assistant. Sarcasm level: {{traits.sarcasm}}/10.
# {{name}} = Telegram bot name unless AGENT_KIBERNIKTO_PERSONA_NAME is set; traits are JSON
# AGENT_KIBERNIKTO_PERSONA_NAME=Kibernikto
AGENT_KIBERNIKTO_PERSONA_TRAITS={"sarcasm":7}


########################
# VOICE TRANSCRIPTION (OpenAI-compatible)
########################
TRANSCRIBE_OPENAI_API_KEY=
TRANSCRIBE_OPENAI_API_MODEL=whisper-1
# TRANSCRIBE_OPENAI_API_BASE_URL=https://api.openai.com/v1
# RouterAI alternative
# TRANSCRIBE_OPENAI_API_MODEL=elevenlabs/scribe-v2
# TRANSCRIBE_OPENAI_API_BASE_URL=https://routerai.ru/api/v1
TRANSCRIBE_OPENAI_API_LANGUAGE=ru

########################
# VOICE REPLIES (OpenAI-compatible TTS; optional)
########################
# TTS_OPENAI_API_KEY=
# TTS_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
# TTS_OPENAI_API_MODEL=elevenlabs/eleven-v4
# TTS_OPENAI_API_VOICE=adam
# TTS_OPENAI_API_DELIVERY_TAGS=[tired] [low, gravelly] [cynical] [dark]
# Optional OpenRouter provider options (JSON object; omit for provider defaults):
# TTS_OPENAI_API_PROVIDER_OPTIONS={"elevenlabs":{"voice_settings":{"stability":0.35,"similarity_boost":0.8}}}


########################
# LOGFIRE — optional; without a token nothing leaves the host
########################
# LOGFIRE_TOKEN=
# agent/model spans in the console; log records are always printed by Kibernikto's own handler
# LOGFIRE_CONSOLE=true
# LOGFIRE_CONSOLE_VERBOSE=false
# who prints records: stdlib (own format + Logfire span lines, default) | logfire (one merged timeline)
# APP_LOG_CONSOLE=stdlib
# stdlib level of the pydantic_ai logger: DEBUG | INFO | WARNING | ERROR
# APP_LOG_PYDANTIC_LEVEL=INFO
# raw provider HTTP requests/responses as spans (very noisy, may contain user content)
# APP_LOG_HTTP=false

# Credits & model balancing for the CreditTier capability
AGENT_KIBERNIKTO_TRIAL_CREDITS=520
AGENT_KIBERNIKTO_POOR_CREDITS=30
AGENT_KIBERNIKTO_RICH_CREDITS=500
AGENT_KIBERNIKTO_POOR_MODEL=openrouter:google/gemini-2.5-flash
AGENT_KIBERNIKTO_MEDIUM_MODEL=openrouter:anthropic/claude-sonnet-5
AGENT_KIBERNIKTO_RICH_MODEL=openrouter:anthropic/claude-sonnet-5
# credits per successful main-agent run; 0 = free
AGENT_KIBERNIKTO_RUN_EFFORT=1
# extra credits per successful subagent call (delegate_task) on top of the run cost; 0 = free
AGENT_KIBERNIKTO_SUBAGENT_EFFORT=1

########################
# WEB — AGENT_KIBERNIKTO_WEB_MODEL_NAME set: web is a tool-less delegate on that search-native
# model (e.g. routerai:perplexity/sonar-reasoning-pro); EXA_API_KEY is then unused.
# Empty: web tools sit on the main (credit-tier) model — Exa search/page when EXA_API_KEY
# is set, else stock Researcher (provider-native search, DuckDuckGo fallback, local page fetch)
########################
EXA_API_KEY=
AGENT_KIBERNIKTO_WEB_MODEL_NAME=

########################
# JINA AI — opt-in report expert (deepsearch)
########################
JINA_AI_API_KEY=

########################
# VKUSVILL — shopping agent (main.py --vkusvill) over https://mcp.vkusvill.ru/mcp
# AUTH_MODE=anonymous: public catalog tools, the cart is returned as a share link.
# AUTH_MODE=oauth: register a client at https://vkusvill.ru/oauth/registration/ and paste the
#                  credentials from the email; the first run opens the browser for the callback.
########################
# NAME rides attribution HTTP headers, so keep it ASCII
# AGENT_VKUSVILL_NAME=vkusvill
# AGENT_VKUSVILL_MCP_URL=https://mcp.vkusvill.ru/mcp
# AGENT_VKUSVILL_AUTH_MODE=anonymous
# AGENT_VKUSVILL_MODEL_NAME=
# AGENT_VKUSVILL_ENABLED=false
# AGENT_VKUSVILL_MIN_CREDITS=2000
# AGENT_VKUSVILL_OAUTH_CLIENT_ID=
# AGENT_VKUSVILL_OAUTH_CLIENT_SECRET=
# AGENT_VKUSVILL_OAUTH_SCOPES=["catalog.search","purchase_history.read","discounts.view","recommendations.personalized"]
# AGENT_VKUSVILL_OAUTH_CALLBACK_PORT=8765
# AGENT_VKUSVILL_OAUTH_CALLBACK_HOST=localhost
# AGENT_VKUSVILL_OAUTH_TOKEN_DIR=

########################
# TRAVEL — gated travel coordinator with Tutu and Kiwi
########################
# Travel coordinator — private chats above the credit threshold.
AGENT_TRAVEL_ENABLED=true
# AGENT_TRAVEL_MIN_CREDITS=2000
# AGENT_TRAVEL_MODEL_NAME=
# AGENT_TRAVEL_MODEL_MAX_TOKENS=8192
# AGENT_TRAVEL_TUTU_MODEL_NAME=
# AGENT_TRAVEL_TUTU_MODEL_MAX_TOKENS=8192
# AGENT_TRAVEL_TUTU_MCP_URL=https://mcp.tutu.ru/mcp
# AGENT_TRAVEL_MAX_TOOL_CALLS=40
# Kiwi is used through the travel coordinator.
# AGENT_KIWI_MODEL_NAME=routerai:anthropic/claude-haiku-5.5
# AGENT_KIWI_MODEL_MAX_TOKENS=8192
# AGENT_KIWI_MCP_URL=https://mcp.kiwi.com
# AGENT_KIWI_MAX_TOOL_CALLS=20

########################
# BUSINESS — DaData, enabled when both keys are present in the token
########################
# AGENT_BUSINESS_DADATA_TOKEN=<api_key>:<secret_key>
# AGENT_BUSINESS_MIN_CREDITS=2000
# AGENT_BUSINESS_MODEL_NAME=
# AGENT_BUSINESS_MAX_TOOL_CALLS=20
